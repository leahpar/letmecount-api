# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL=
###< doctrine/doctrine-bundle ###
###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/var/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/var/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> pofiler ###
PROFILER_PWD=
TRUSTED_IPS=
###< pofiler ###

###> web-auth/webauthn-symfony-bundle ###
# Domaine du FRONT (pas de l'API) : c'est là que se joue la cérémonie WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ALLOWED_ORIGIN=http://localhost:5173
###< web-auth/webauthn-symfony-bundle ###

###> oauth ###
# Client OAuth "Web application" créé dans la Google Cloud Console.
# Origine JS autorisée : l'URL du front. URI de redirection : OAUTH_REDIRECT_URI ci-dessous.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Services ID créé dans le portail Apple Developer (Identifiers > Services IDs).
# C'est lui qui fait office de client_id ; le Team ID et le Key ID font 10 caractères.
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contenu du fichier .p8 encodé en base64 (base64 -w0 AuthKey_XXXXXXXXXX.p8),
# pour tenir sur une ligne : un PEM multi-lignes ne passe pas en variable d'env.
APPLE_PRIVATE_KEY_BASE64=
# Instance PocketID auto-hébergée. Le token endpoint (/api/oidc/token) et
# l'issuer attendu en sont dérivés, sans slash final.
POCKETID_BASE_URL=
POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=
# Doit correspondre exactement au redirect_uri déclaré chez Google, Apple et
# PocketID, et à celui utilisé par le front.
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
# Audience de nos propres JWT (identifiant de la ressource protégée).
JWT_AUDIENCE=letmecount-api
###< oauth ###

###> notifications push ###
# Paire de clés VAPID (RFC 8292). À générer UNE FOIS :
#   php bin/console app:vapid:generate
# La publique est aussi à publier côté front (VITE_VAPID_PUBLIC_KEY) : ce n'est
# pas un secret. La privée va dans .env.local / les secrets, et ne doit JAMAIS
# être regénérée — tous les abonnements existants deviendraient invalides.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identité du serveur d'application, exigée par les services de push. Apple
# rejette les JWT dont le `sub` n'est pas une URL mailto: ou https: valide —
# une URL https fait aussi bien l'affaire qu'un mailto, sans exposer d'adresse.
VAPID_SUBJECT=https://letmecount.lasoireefille.fr
###< notifications push ###
